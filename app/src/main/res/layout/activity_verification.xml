<?xml version="1.0" encoding="utf-8"?>
<!-- LinearLayout horizontal: el 3anaser jemb ba3dhom (contrainte 1) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="#F5E6C8">

    <!-- taswira mta3 el msafer 3al isar, wazn mta3ha 0.3 -->
    <ImageView
        android:id="@+id/iv_photo_rs"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.3"
        android:src="@mipmap/ic_launcher" />

    <!-- RelativeLayout 3al imin lel textes, wazn mta3ou 0.7 -->
    <RelativeLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.7">
        <!-- el 3onwen -->

        <TextView
            android:id="@+id/tv_titre_rs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PASSEPORT TEMPOREL" />

        <!-- esm el msafer: ta7t el 3onwen -->
        <TextView
            android:id="@+id/tv_nom_rs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/tv_titre_rs"
            android:text="Nom : " />

        <!-- el 3omr ezzmeni: ta7t el esm -->
        <TextView
            android:id="@+id/tv_age_rs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/tv_nom_rs"
            android:text="Âge temporel : " />

        <!-- sbab el safra: ta7t el 3omr -->
        <TextView
            android:id="@+id/tv_motif_rs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/tv_age_rs"
            android:text="Motif : " />

        <!-- bouton el rafd: fel fouk  mta3 el ecran -->
        <Button
            android:id="@+id/btn_refuser_rs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:text="Refuser (Risque de paradoxe)" />

        <!-- bouton el mowafa9a: fou9 bouton el rafd -->
        <Button
            android:id="@+id/btn_approuver_rs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_above="@id/btn_refuser_rs"
            android:text="Approuver le saut temporel" />

    </RelativeLayout>
</LinearLayout>