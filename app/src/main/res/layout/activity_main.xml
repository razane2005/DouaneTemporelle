<?xml version="1.0" encoding="utf-8"?>
<!-- 1) ScrollView: bech el ecran ykoun fih defilement ki ykoun sghir -->

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".MainActivity">

    <!-- 2) LinearLayout vertical (orientation=vertical) bech el 3anaser yetrakbou fou9 ba3dhom -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- 3) 3onwen el safha -->
        <TextView
            android:id="@+id/titre_rs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/douane_temporelle"
            android:textColor="#3E2723"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/sous_titre_rs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:gravity="center"
            android:text="@string/formulaire_d_enregistrement_du_voyageur"
            android:textColor="#6D4C41"
            android:textSize="16sp" />

        <!-- 4) champ esm el mosafer -->
        <TextView
            android:id="@+id/label_nom_rs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nom_du_voyageur"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/nom_rs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:hint="@string/ex_marty_mcfly"
            android:inputType="textPersonName" />

        <!-- 5) champ sanat el wilada (ar9am bark) -->
        <TextView
            android:id="@+id/label_naissance_rs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ann_e_de_naissance"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/naissance_rs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:hint="@string/ex_1990"
            android:inputType="number"
            android:maxLength="4" />

        <!-- 6) champ sanat el wijha (ar9am bark) -->
        <TextView
            android:id="@+id/label_destination_rs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ann_e_de_destination"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/destination_rs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:hint="@string/ex_2050"
            android:inputType="number"
            android:maxLength="4" />

        <!-- 7) liste mta3 el motif (Spinner) mta3 sabab el safra -->
        <TextView
            android:id="@+id/label_motif_rs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/motif_du_voyage"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/motif_rs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            android:entries="@array/motifs_voyage" />

        <!-- 8) bouton el test: yet7el el Activity 2 -->
        <Button
            android:id="@+id/btn_inspecter_rs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/inspecter_le_profil" />

    </LinearLayout>
</ScrollView>